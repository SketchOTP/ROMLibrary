{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:authority:atlas-assertion:v1",
  "title": "Proposed append-only manual assertion",
  "type": "object",
  "required": [
    "schema_version",
    "assertion_id",
    "repository_id",
    "observed_at",
    "actor",
    "kind",
    "subject_id",
    "object_id",
    "relation",
    "value",
    "supersedes",
    "retracts",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "authority.atlas-assertion.v1"
    },
    "assertion_id": {
      "type": "string",
      "format": "uuid"
    },
    "repository_id": {
      "type": "string",
      "format": "uuid"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "RELATIONSHIP",
        "PATH_BINDING",
        "CLASSIFICATION"
      ]
    },
    "subject_id": {
      "type": "string",
      "pattern": "^repo:[0-9a-fA-F-]{36}/entity:[0-9a-fA-F-]{36}$"
    },
    "object_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^repo:[0-9a-fA-F-]{36}/entity:[0-9a-fA-F-]{36}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "relation": {
      "type": [
        "string",
        "null"
      ]
    },
    "value": {
      "type": [
        "object",
        "null"
      ]
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "retracts": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "hash",
          "evidence_class"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_class": {
            "enum": [
              "INDEXER_DERIVED",
              "SYNTAX_DERIVED",
              "RUNTIME_OBSERVED",
              "DOCUMENTED",
              "INFERRED",
              "UNRESOLVED",
              "STALE"
            ]
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RELATIONSHIP"
          }
        }
      },
      "then": {
        "properties": {
          "object_id": {
            "type": "string",
            "pattern": "^repo:[0-9a-fA-F-]{36}/entity:[0-9a-fA-F-]{36}$"
          },
          "relation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "PATH_BINDING",
              "CLASSIFICATION"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    }
  ]
}
